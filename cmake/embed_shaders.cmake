# Generates a C file that holds the shader sources as NUL-terminated strings, so
# the executable can run without the assets directory next to it.
#
# Run in script mode:
#   cmake -DSHADER_DIR=<dir> -DSHADER_NAMES=<a;b;...> -DOUTPUT=<file.c> -P embed_shaders.cmake
#
# The bytes are written as hex, so nothing in a shader needs escaping.

foreach(var SHADER_DIR SHADER_NAMES OUTPUT)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "embed_shaders.cmake: ${var} is not set")
    endif()
endforeach()

set(arrays "")
set(entries "")
set(index 0)
foreach(name IN LISTS SHADER_NAMES)
    file(READ "${SHADER_DIR}/${name}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(APPEND arrays "static const char shader_${index}[] = {${hex}0x00};\n\n")
    string(APPEND entries "    {\"${name}\", shader_${index}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "/* Generated by cmake/embed_shaders.cmake from assets/shaders. Do not edit. */

#include \"render/builtin_shaders.h\"

#include <stddef.h>
#include <string.h>

${arrays}static const struct {
    const char *name;
    const char *source;
} builtin_shaders[] = {
${entries}};

const char *builtin_shader_source(const char *name)
{
    for (size_t i = 0; i < sizeof builtin_shaders / sizeof builtin_shaders[0]; ++i) {
        if (strcmp(builtin_shaders[i].name, name) == 0) {
            return builtin_shaders[i].source;
        }
    }
    return NULL;
}
")

# Only touch the file when it changes, so an unrelated reconfigure does not
# recompile it.
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${content}" @ONLY)
